{
  "name": "bc102e44-60d5-4f15-9d49-0600b787569a",
  "id": "/providers/Microsoft.Flow/flows/bc102e44-60d5-4f15-9d49-0600b787569a",
  "type": "Microsoft.Flow/flows",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "EnvoiPhotosChantier",
    "definition": {
      "metadata": {
        "workflowEntityId": null,
        "processAdvisorMetadata": null,
        "flowChargedByPaygo": null,
        "flowclientsuspensionreason": "None",
        "flowclientsuspensiontime": null,
        "flowclientsuspensionreasondetails": "",
        "provisioningMethod": "FromDefinition",
        "failureAlertSubscription": true,
        "creationSource": "Portal",
        "modifiedSources": "Portal"
      },
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "projectFolderPath": {
                  "type": "string",
                  "description": "ProjectFolderPath du chantier (ex: /Copie RTE ENEDIS/Projet 2026/Urrugne/Arborescence RTE type 2.0)",
                  "x-ms-dynamically-added": true,
                  "x-ms-content-hint": "TEXT"
                },
                "photosJson": {
                  "type": "string",
                  "description": "PhotoPayloadJSON du PCF : [{base64, fileName, liaisonFolder, elementFolder, ...}]",
                  "x-ms-dynamically-added": true,
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "projectFolderPath",
                "photosJson"
              ]
            }
          }
        }
      },
      "actions": {
        "Initialiser_varResultat": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varResultat",
                "type": "string",
                "value": "error"
              }
            ]
          },
          "runAfter": {}
        },
        "Photos": {
          "type": "Compose",
          "inputs": "@coalesce(json(triggerBody()?['photosJson']), createArray())",
          "runAfter": {
            "Initialiser_varResultat": [
              "Succeeded"
            ]
          }
        },
        "SegmentsChemin": {
          "type": "Query",
          "inputs": {
            "from": "@split(trim(coalesce(triggerBody()?['projectFolderPath'], '')), '/')",
            "where": "@not(equals(trim(item()), ''))"
          },
          "runAfter": {
            "Photos": [
              "Succeeded"
            ]
          }
        },
        "TablettePath": {
          "type": "Compose",
          "inputs": "@concat('/', join(body('SegmentsChemin'), '/'), '/6. Tablette')",
          "runAfter": {
            "SegmentsChemin": [
              "Succeeded"
            ]
          }
        },
        "Verifier_entrees": {
          "type": "If",
          "expression": "@and(greater(length(body('SegmentsChemin')), 0), greater(length(outputs('Photos')), 0))",
          "actions": {
            "Pour_chaque_photo": {
              "type": "Foreach",
              "foreach": "@outputs('Photos')",
              "actions": {
                "LiaisonBrute": {
                  "type": "Compose",
                  "inputs": "@trim(coalesce(items('Pour_chaque_photo')?['liaisonFolder'], ''))",
                  "runAfter": {}
                },
                "SafeLiaison": {
                  "type": "Compose",
                  "inputs": "@replace(replace(replace(replace(replace(replace(replace(replace(replace(outputs('LiaisonBrute'), '\"', '_'), '*', '_'), ':', '_'), '<', '_'), '>', '_'), '?', '_'), '/', '_'), '\\', '_'), '|', '_')",
                  "runAfter": {
                    "LiaisonBrute": [
                      "Succeeded"
                    ]
                  }
                },
                "ElementBrut": {
                  "type": "Compose",
                  "inputs": "@if(equals(trim(coalesce(items('Pour_chaque_photo')?['elementFolder'], '')), ''), 'Général', trim(items('Pour_chaque_photo')?['elementFolder']))",
                  "runAfter": {
                    "SafeLiaison": [
                      "Succeeded"
                    ]
                  }
                },
                "SafeElement": {
                  "type": "Compose",
                  "inputs": "@replace(replace(replace(replace(replace(replace(replace(replace(replace(outputs('ElementBrut'), '\"', '_'), '*', '_'), ':', '_'), '<', '_'), '>', '_'), '?', '_'), '/', '_'), '\\', '_'), '|', '_')",
                  "runAfter": {
                    "ElementBrut": [
                      "Succeeded"
                    ]
                  }
                },
                "DossierCible": {
                  "type": "Compose",
                  "inputs": "@concat(outputs('TablettePath'), if(equals(outputs('SafeLiaison'), ''), '', concat('/', outputs('SafeLiaison'))), '/', outputs('SafeElement'))",
                  "runAfter": {
                    "SafeElement": [
                      "Succeeded"
                    ]
                  }
                },
                "Creer_fichier": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "CreateFile",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "https://nexans.sharepoint.com/sites/t-nex",
                      "folderPath": "@outputs('DossierCible')",
                      "name": "@items('Pour_chaque_photo')?['fileName']",
                      "body": "@base64ToBinary(items('Pour_chaque_photo')?['base64'])"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "DossierCible": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 5
                }
              },
              "runAfter": {}
            },
            "Resultat_ok": {
              "type": "SetVariable",
              "inputs": {
                "name": "varResultat",
                "value": "ok"
              },
              "runAfter": {
                "Pour_chaque_photo": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "TablettePath": [
              "Succeeded"
            ]
          }
        },
        "Repondre_a_PowerApps": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "result": "@variables('varResultat')",
              "count": "@{if(equals(variables('varResultat'), 'ok'), length(outputs('Photos')), 0)}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "title": "result",
                  "type": "string",
                  "x-ms-dynamically-added": true
                },
                "count": {
                  "title": "count",
                  "type": "string",
                  "x-ms-dynamically-added": true
                }
              }
            }
          },
          "runAfter": {
            "Verifier_entrees": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        }
      }
    },
    "connectionReferences": {
      "shared_sharepointonline": {
        "connectionName": "shared_sharepointonline",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "tier": "NotSpecified",
        "apiName": "sharepointonline",
        "isProcessSimpleApiReferenceConversionAlreadyDone": false
      }
    },
    "flowFailureAlertSubscribed": false,
    "isManaged": false
  }
}
